{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/gidosa-rdb": ["libs/gidosa-rdb/src"],
      "@app/gidosa-rdb/*": ["libs/gidosa-rdb/src/*"],
      "@app/gidosa-common-api": ["libs/gidosa-common-api/src"],
      "@app/gidosa-common-api/*": ["libs/gidosa-common-api/src/*"],
      "@app/gidosa-common": ["libs/gidosa-common/src"],
      "@app/gidosa-common/*": ["libs/gidosa-common/src/*"]
    }
  }
}
